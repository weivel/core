# -DLAYOUTS=<layouts executable> -DHEADERS=<directory of public headers>, or -DPRINTED=<file> in place of LAYOUTS to
# read lines the executable printed before.
#
# Every struct a public header defines, with or without a typedef and anonymous or tagged, has a sizeof line and no
# other struct has one; every printed line is a field or a sizeof line; and each struct prints exactly the fields its
# header declares, by name and in declaration order, so a struct or a field added to a header and forgotten in the
# layouts executable fails here. A member of a nested struct or union is named after the field holding it, as in
# `data.want`, after a line for that field itself.

cmake_minimum_required(VERSION 3.15)

if(DEFINED PRINTED)
    file(READ "${PRINTED}" output)
else()
    execute_process(COMMAND ${LAYOUTS} RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT code STREQUAL "0")
        message(FATAL_ERROR "${LAYOUTS} exited ${code}\n${errors}")
    endif()
endif()
string(REPLACE "\r" "" output "${output}")
string(REPLACE "\n" ";" lines "${output}")
list(FILTER lines EXCLUDE REGEX "^$")
list(LENGTH lines line_count)
if(line_count EQUAL 0)
    message(FATAL_ERROR "the layouts printed nothing, so nothing was checked")
endif()

set(offenders "")

function(read_printed_layouts)
    set(found_offenders "")
    set(sized "")
    set(with_fields "")
    foreach(line IN LISTS lines)
        if(line MATCHES "^([^ ]+) sizeof [0-9]+$")
            list(APPEND sized "${CMAKE_MATCH_1}")
        elseif(line MATCHES "^([^ ]+) ([^ ]+) [0-9]+ [0-9]+$")
            set(struct "${CMAKE_MATCH_1}")
            list(APPEND with_fields "${struct}")
            list(APPEND printed_fields_of_${struct} "${CMAKE_MATCH_2}")
            set(printed_fields_of_${struct} "${printed_fields_of_${struct}}" PARENT_SCOPE)
        else()
            list(APPEND found_offenders "malformed line '${line}'")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES with_fields)
    foreach(struct IN LISTS with_fields)
        if(NOT struct IN_LIST sized)
            list(APPEND found_offenders "${struct}: fields but no sizeof line")
        endif()
    endforeach()
    set(printed ${sized} ${with_fields})
    if(printed)
        list(REMOVE_DUPLICATES printed)
    endif()
    set(printed "${printed}" PARENT_SCOPE)
    set(offenders ${offenders} ${found_offenders} PARENT_SCOPE)
endfunction()

# A header reduced to tokens: comments, preprocessor lines and array bounds gone, `;` spelled `__semicolon__` so it
# survives as a list element, and brackets spelled out so a list never reads them as quoting.
function(tokenize_header header out)
    file(READ "${header}" content)
    string(REPLACE "\r" "" content "${content}")
    string(REPLACE "\\\n" " " content "${content}")
    set(code "")
    set(rest "${content}")
    while(TRUE)
        string(FIND "${rest}" "/*" open)
        if(open EQUAL -1)
            string(APPEND code "${rest}")
            break()
        endif()
        string(SUBSTRING "${rest}" 0 ${open} before)
        string(APPEND code "${before} ")
        math(EXPR after "${open} + 2")
        string(SUBSTRING "${rest}" ${after} -1 rest)
        string(FIND "${rest}" "*/" close)
        if(close EQUAL -1)
            message(FATAL_ERROR "${header} has a comment that never ends")
        endif()
        math(EXPR after "${close} + 2")
        string(SUBSTRING "${rest}" ${after} -1 rest)
    endwhile()
    string(REGEX REPLACE "//[^\n]*" "" code "${code}")
    string(REGEX REPLACE "\n[ \t]*#[^\n]*" "\n" code "\n${code}")
    string(REPLACE ";" " __semicolon__ " code "${code}")
    string(REPLACE "[" " __open_bracket__ " code "${code}")
    string(REPLACE "]" " __close_bracket__ " code "${code}")
    string(REGEX MATCHALL "[A-Za-z_][A-Za-z0-9_]*|[{}(),*]" tokens "${code}")
    set(${out} "${tokens}" PARENT_SCOPE)
endfunction()

# The names one declaration statement declares: the identifier inside `(*name)` for a function pointer, else the last
# identifier of each comma-separated declarator.
function(declarator_names out)
    set(names "")
    set(depth 0)
    set(piece "")
    foreach(token IN LISTS ARGN ITEMS ",")
        if(token STREQUAL "(")
            math(EXPR depth "${depth} + 1")
        elseif(token STREQUAL ")")
            math(EXPR depth "${depth} - 1")
        endif()
        if(token STREQUAL "," AND depth EQUAL 0)
            set(name "")
            set(after_open "")
            foreach(part IN LISTS piece)
                if(after_open STREQUAL "(*" AND part MATCHES "^[A-Za-z_]" AND NOT part MATCHES "^(const|volatile|restrict)$")
                    set(pointer_name "${part}")
                    set(after_open "done")
                elseif(after_open STREQUAL "(" AND part STREQUAL "*")
                    set(after_open "(*")
                elseif(after_open STREQUAL "" AND part STREQUAL "(")
                    set(after_open "(")
                elseif(after_open STREQUAL "(")
                    set(after_open "")
                endif()
                if(part MATCHES "^[A-Za-z_]" AND after_open STREQUAL "")
                    set(name "${part}")
                endif()
            endforeach()
            if(after_open STREQUAL "done")
                list(APPEND names "${pointer_name}")
            elseif(NOT name STREQUAL "")
                list(APPEND names "${name}")
            endif()
            set(piece "")
        else()
            list(APPEND piece "${token}")
        endif()
    endforeach()
    set(${out} "${names}" PARENT_SCOPE)
endfunction()

# The field names a struct body declares in order, each nested struct or union member after its own field and prefixed
# with that field's name and a dot; an anonymous nested member's fields take no prefix.
function(member_names out prefix)
    set(members "")
    set(statement "")
    set(inner "")
    set(has_inner FALSE)
    set(depth 0)
    set(bracket_depth 0)
    foreach(token IN LISTS ARGN)
        if(token STREQUAL "__open_bracket__")
            math(EXPR bracket_depth "${bracket_depth} + 1")
            continue()
        elseif(token STREQUAL "__close_bracket__")
            math(EXPR bracket_depth "${bracket_depth} - 1")
            continue()
        elseif(bracket_depth GREATER 0)
            continue()
        endif()
        if(depth GREATER 0)
            if(token STREQUAL "{")
                math(EXPR depth "${depth} + 1")
            elseif(token STREQUAL "}")
                math(EXPR depth "${depth} - 1")
            endif()
            if(depth GREATER 0)
                list(APPEND inner "${token}")
            endif()
        elseif(token STREQUAL "{")
            set(depth 1)
            set(has_inner TRUE)
            set(statement "")
        elseif(token STREQUAL "__semicolon__")
            declarator_names(names ${statement})
            foreach(name IN LISTS names)
                list(APPEND members "${prefix}${name}")
                if(has_inner)
                    member_names(nested "${prefix}${name}." ${inner})
                    list(APPEND members ${nested})
                endif()
            endforeach()
            if(has_inner AND NOT names)
                member_names(nested "${prefix}" ${inner})
                list(APPEND members ${nested})
            endif()
            set(statement "")
            set(inner "")
            set(has_inner FALSE)
        else()
            list(APPEND statement "${token}")
        endif()
    endforeach()
    set(${out} "${members}" PARENT_SCOPE)
endfunction()

# Every struct or union a header defines at file scope, as `struct weivel_x {` with or without a typedef, or as
# `typedef struct {` named after its closing brace, with the fields its body declares.
function(read_header_structs header)
    tokenize_header("${header}" tokens)
    set(found "")
    set(state outside)
    set(previous "")
    set(before_previous "")
    foreach(token IN LISTS tokens)
        if(state STREQUAL "body")
            if(token STREQUAL "{")
                math(EXPR depth "${depth} + 1")
            elseif(token STREQUAL "}")
                math(EXPR depth "${depth} - 1")
            endif()
            if(depth GREATER 0)
                list(APPEND body "${token}")
            elseif(name STREQUAL "")
                set(state name_after_body)
            else()
                set(state ended)
            endif()
        elseif(state STREQUAL "name_after_body")
            if(token MATCHES "^[A-Za-z_]")
                set(name "${token}")
                set(state ended)
            endif()
        elseif(token STREQUAL "{" AND before_previous MATCHES "^(struct|union)$" AND previous MATCHES "^weivel_")
            set(name "${previous}")
            set(state body)
            set(depth 1)
            set(body "")
        elseif(token STREQUAL "{" AND before_previous STREQUAL "typedef" AND previous MATCHES "^(struct|union)$")
            set(name "")
            set(state body)
            set(depth 1)
            set(body "")
        endif()
        if(state STREQUAL "ended")
            if(name MATCHES "^weivel_")
                member_names(fields "" ${body})
                list(APPEND found "${name}")
                set(declared_fields_of_${name} "${fields}" PARENT_SCOPE)
            endif()
            set(state outside)
        endif()
        set(before_previous "${previous}")
        set(previous "${token}")
    endforeach()
    set(declared ${declared} ${found} PARENT_SCOPE)
endfunction()

read_printed_layouts()

file(GLOB_RECURSE headers "${HEADERS}/*.h")
set(declared "")
foreach(header IN LISTS headers)
    read_header_structs("${header}")
endforeach()
list(LENGTH declared declared_count)
if(declared_count EQUAL 0)
    message(FATAL_ERROR "no struct defined under ${HEADERS}, so nothing was checked")
endif()

foreach(name IN LISTS declared)
    if(NOT name IN_LIST printed)
        list(APPEND offenders "${name} is declared under ${HEADERS} and has no layout")
    elseif(NOT "${printed_fields_of_${name}}" STREQUAL "${declared_fields_of_${name}}")
        string(REPLACE ";" " " printed_names "${printed_fields_of_${name}}")
        string(REPLACE ";" " " declared_names "${declared_fields_of_${name}}")
        list(APPEND offenders
            "${name} prints the fields ${printed_names} but its header declares ${declared_names}")
    endif()
endforeach()
foreach(name IN LISTS printed)
    if(NOT name IN_LIST declared)
        list(APPEND offenders "${name} has a layout and is declared by no public header")
    endif()
endforeach()
if(offenders)
    string(REPLACE ";" "\n" report "${offenders}")
    message(FATAL_ERROR "${report}")
endif()
message(STATUS "${declared_count} public structs, each with a layout of every field it declares")
