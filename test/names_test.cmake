# -DSOURCE_ROOT=<repo> -DWORDS=<file>: fails when weivel's own code or prose names a word listed in WORDS.

file(STRINGS "${WORDS}" words)
list(FILTER words EXCLUDE REGEX "^[ \t]*$")
list(LENGTH words word_count)
if(word_count EQUAL 0)
    message(FATAL_ERROR "no words in ${WORDS}")
endif()

file(GLOB_RECURSE files "${SOURCE_ROOT}/include/*" "${SOURCE_ROOT}/src/*" "${SOURCE_ROOT}/test/*")
list(APPEND files "${SOURCE_ROOT}/CONTENT.md" "${SOURCE_ROOT}/CMakeLists.txt")
get_filename_component(word_list "${WORDS}" ABSOLUTE)
list(REMOVE_ITEM files "${word_list}")

set(offenders "")
foreach(file IN LISTS files)
    file(READ "${file}" content)
    string(TOLOWER "${content}" lowered)
    foreach(word IN LISTS words)
        string(TOLOWER "${word}" lowered_word)
        string(FIND "${lowered}" "${lowered_word}" position)
        if(NOT position EQUAL -1)
            list(APPEND offenders "${file}: ${word}")
        endif()
    endforeach()
endforeach()

if(offenders)
    string(REPLACE ";" "\n  " listed "${offenders}")
    message(FATAL_ERROR "names weivel must not carry:\n  ${listed}")
endif()
list(LENGTH files file_count)
message(STATUS "${file_count} files carry none of ${word_count} names")
